RPC_URL=https://api.devnet.solana.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: run the live agent on OpenRouter free models instead (npm run agent -- --openrouter)
OPENROUTER_API_KEY=
# comma-separated, tried in order; default is a few free tool-capable models
OPENROUTER_MODEL=
# Optional: Mistral (npm run agent -- --mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Optional: Groq (npm run agent -- --groq)
GROQ_API_KEY=
GROQ_MODEL=
